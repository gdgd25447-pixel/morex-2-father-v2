<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="4dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/bubble"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxWidth="280dp"
        app:cardCornerRadius="16dp" app:cardElevation="1dp">
        <TextView android:id="@+id/tvMessage"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="12dp" android:text="رسالة"
            android:textColor="@color/text_primary" android:textSize="14sp" />
    </androidx.cardview.widget.CardView>
</LinearLayout>
