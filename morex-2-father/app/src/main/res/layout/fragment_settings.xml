<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <!-- Header -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="20dp" app:cardElevation="2dp"
            app:cardBackgroundColor="@color/morex_blue">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="20dp"
                android:gravity="center_vertical">

                <ImageView android:layout_width="70dp" android:layout_height="70dp"
                    android:src="@mipmap/ic_launcher"
                    android:background="@drawable/bg_avatar_ring" android:padding="4dp" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginStart="16dp">
                    <TextView android:id="@+id/tvName"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/white"
                        android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvPhone"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="#B4C6E7" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Account -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="الحساب" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:layout_marginTop="20dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/rowProfile"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_person" app:tint="@color/morex_blue" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="الملف الشخصي"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:layout_marginStart="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" />

                <LinearLayout android:id="@+id/rowSubscription"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_person" app:tint="@color/morex_gold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="الاشتراك الحالي"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:layout_marginStart="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" />

                <LinearLayout android:id="@+id/rowReferral"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_person" app:tint="@color/morex_gold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="كود الإحالة"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:layout_marginStart="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- الأدوات -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="الأدوات" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:layout_marginTop="20dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/rowReports"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_nav_alerts" app:tint="@color/morex_blue" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="التقارير والإحصائيات"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:layout_marginStart="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" />

                <LinearLayout android:id="@+id/rowDevices"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_nav_children" app:tint="@color/morex_blue" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="الأجهزة المرتبطة"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:layout_marginStart="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" />

                <LinearLayout android:id="@+id/rowLegal"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_shield_check" app:tint="@color/morex_blue" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="الخصوصية والشروط"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:layout_marginStart="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Support -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="الدعم" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:layout_marginTop="20dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/rowFaq"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_nav_alerts" app:tint="@color/morex_blue" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="الأسئلة الشائعة"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:layout_marginStart="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" />

                <LinearLayout android:id="@+id/rowChat"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_person" app:tint="@color/morex_blue" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="تواصل معنا"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:layout_marginStart="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="🚪 تسجيل الخروج"
            android:textColor="@color/status_danger"
            android:background="@drawable/bg_pill_red"
            android:layout_marginTop="24dp"
            app:backgroundTint="@android:color/transparent" />
    </LinearLayout>
</ScrollView>
