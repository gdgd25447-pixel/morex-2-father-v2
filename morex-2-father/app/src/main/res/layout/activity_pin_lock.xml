<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <Space android:layout_width="match_parent" android:layout_height="40dp" />

            <ImageView
                android:layout_width="120dp" android:layout_height="120dp"
                android:src="@drawable/ic_lock_secure"
                android:background="@drawable/bg_circle_light_blue"
                android:padding="24dp"
                android:contentDescription="locked" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="التطبيق مقفل"
                android:textColor="@color/text_on_primary"
                android:textSize="26sp" android:textStyle="bold"
                android:layout_marginTop="20dp" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="أدخل رمز PIN للمتابعة"
                android:textColor="#94A3B8" android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <Space android:layout_width="match_parent" android:layout_height="32dp" />

            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <View android:id="@+id/dot1" android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_marginEnd="20dp" android:background="@drawable/bg_dot_focused" />
                <View android:id="@+id/dot2" android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_marginEnd="20dp" android:background="@drawable/bg_dot_empty" />
                <View android:id="@+id/dot3" android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_marginEnd="20dp" android:background="@drawable/bg_dot_empty" />
                <View android:id="@+id/dot4" android:layout_width="24dp" android:layout_height="24dp"
                    android:background="@drawable/bg_dot_empty" />
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="40dp" />

            <!-- Number Pad 1-3 -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="3">
                <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="1" android:textSize="26sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn" />
                <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="2" android:textSize="26sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn"
                    android:layout_marginStart="12dp" />
                <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="3" android:textSize="26sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Number Pad 4-6 -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="3"
                android:layout_marginTop="12dp">
                <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="4" android:textSize="26sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn" />
                <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="5" android:textSize="26sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn"
                    android:layout_marginStart="12dp" />
                <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="6" android:textSize="26sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Number Pad 7-9 -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="3"
                android:layout_marginTop="12dp">
                <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="7" android:textSize="26sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn" />
                <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="8" android:textSize="26sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn"
                    android:layout_marginStart="12dp" />
                <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="9" android:textSize="26sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Bottom Row -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="3"
                android:layout_marginTop="12dp">
                <Button android:id="@+id/btnBiometric" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="👆" android:textSize="24sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn"
                    android:visibility="gone" />
                <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="0" android:textSize="26sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn"
                    android:layout_marginStart="12dp" />
                <Button android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="72dp"
                    android:layout_weight="1" android:text="⌫" android:textSize="26sp"
                    android:textColor="@color/text_on_primary" android:background="@drawable/bg_num_btn"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="20dp" />

            <TextView
                android:id="@+id/btnForgot"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="نسيت الرمز؟"
                android:textColor="@color/morex_gold"
                android:textSize="14sp" android:textStyle="bold"
                android:padding="12dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
