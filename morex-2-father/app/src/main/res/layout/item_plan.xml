<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp" app:cardElevation="2dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:id="@+id/tvPlanName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="الباقة" android:textColor="@color/text_primary"
            android:textSize="20sp" android:textStyle="bold" />

        <TextView android:id="@+id/tvPlanPrice"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="$3 / شهرياً" android:textColor="@color/morex_gold"
            android:textSize="22sp" android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView android:id="@+id/tvPlanDevices"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="3 أجهزة" android:textColor="@color/text_secondary"
            android:textSize="14sp" android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubscribe"
            style="@style/MorexButton.Primary"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="اشتراك"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
