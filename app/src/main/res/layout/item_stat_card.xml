<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="110dp"
    app:cardCornerRadius="16dp" app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/ic_location_pin" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="عنوان" android:textColor="@color/text_secondary"
            android:textSize="12sp" android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/text_primary"
            android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
